DATABASE_URL=sqlite:///./sante.db
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Notifications / delivery queue
# MAIL_BACKEND: console (log only, default) | file (.eml files in MAIL_OUTBOX_DIR) | smtp | memory (tests)
MAIL_BACKEND=console
MAIL_FROM=Santé Saúde <no-reply@sante-saude.example>
MAIL_OUTBOX_DIR=./outbox
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=1
# In-process worker (reminders, monthly payout closing, outbox relay + consumer).
# Set 0 in the API when running separate worker processes: `python -m app.worker`.
WORKER_ENABLED=1
WORKER_INTERVAL_SECONDS=30

# Message broker behind the outbox. memory (default: in process) or RabbitMQ, e.g.
# BROKER_URL=amqp://guest:guest@localhost:5672/%2F  (needs `pip install pika`)
BROKER_URL=memory
BROKER_EXCHANGE=sante
BROKER_QUEUE=sante.jobs
BROKER_PREFETCH=10

# Automatic monthly settlements (previous month closed on SETTLEMENT_DAY of each month)
SETTLEMENT_DAY=1
SETTLEMENT_FIRST_DUE_DAYS=5
SETTLEMENT_INTERVAL_DAYS=30
# one more installment per this much of net amount, capped
SETTLEMENT_INSTALLMENT_STEP_CENTS=200000
SETTLEMENT_MAX_INSTALLMENTS=3

# Remote appointments (video call): base of the meeting links issued at booking
# (a unique room name is appended). Any service that opens a room by URL works.
REMOTE_MEETING_BASE_URL=https://meet.jit.si

# Medical prescriptions attached to appointments: where the files are kept,
# the size limit per file and how long a download link stays valid (30 days at most).
PRESCRIPTIONS_DIR=./prescriptions
PRESCRIPTION_MAX_BYTES=10485760
PRESCRIPTION_LINK_DAYS=30
# End-to-end encrypted chat of remote appointments: where the encrypted
# attachments are kept and the size limit per attachment.
CHAT_ATTACHMENTS_DIR=./chat-attachments
CHAT_ATTACHMENT_MAX_BYTES=10485760

# Digital signature of prescriptions (ICP-Brasil): the PEM bundle of the trusted
# root CAs — download "ACcompactado.zip" from https://acraiz.icpbrasil.gov.br and
# concatenate the root certificates (PEM) into this file. Without it nothing can
# be signed. For local trials, scripts/make_demo_certificate.py builds a demo PKI.
ICP_BRASIL_TRUST_BUNDLE=./icp-brasil-roots.pem
# Optional: reference the ICP-Brasil AD-RB signature policy in every signature
# (OID, URL and SHA-256 of the policy file, e.g. PA_AD_RB_v2_3.der). Leave blank
# for a plain CAdES-BES signature.
ICP_BRASIL_POLICY_OID=
ICP_BRASIL_POLICY_URL=
ICP_BRASIL_POLICY_SHA256=

# Attendance: check-in window around the appointment slot (minutes)
CHECKIN_OPENS_BEFORE_MINUTES=120
CHECKIN_CLOSES_AFTER_MINUTES=120
